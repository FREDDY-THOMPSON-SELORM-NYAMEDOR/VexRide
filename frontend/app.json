{
  "expo": {
    "name": "VexRide",
    "description": "Community-powered mobility platform connecting people through shared journeys.",
    "slug": "vexride",
    "scheme": "vexride",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "backgroundColor": "#000000",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.poptony.vexride"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "VexRide",
      "shortName": "Vex",
      "themeColor": "#ff5e36",
      "backgroundColor": "#000000"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VexRide uses your location to find nearby ride partners."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "defb89c2-40f0-4de0-832a-79b0e2e4d9e3"
      }
    }
  }
}
