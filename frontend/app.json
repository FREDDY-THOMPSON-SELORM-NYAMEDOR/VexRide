{
  "expo": {
    "name": "VexRide",
    "slug": "vexride",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.poptony.vexride"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VexRide uses your location to find nearby ride partners."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "defb89c2-40f0-4de0-832a-79b0e2e4d9e3"
      }
    }
  }
}
